{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/protocol",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "node --import @opencode-ai/nub-test/hooks --test --test-force-exit --test-timeout=30000 --test-reporter=dot 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@opencode-ai/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@opencode-ai/nub-test": "workspace:*"
  }
}
